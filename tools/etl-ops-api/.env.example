# Copy to .env — never commit .env (gitignored).

CHAT_MODE=agent
CHAT_PROVIDER=gemini

# Google Gemini — get key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_TOOL_ROUNDS=5

# OpenRouter (optional — set CHAT_PROVIDER=openrouter)
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Force v1 rule-based chat:
# CHAT_MODE=rules

# Failure alerts ingest (Fabric notification notebook dual-write)
# NOTIFICATIONS_INGEST_KEY=optional-shared-secret
# NOTIFICATIONS_INGEST_URL=http://127.0.0.1:8000/api/notifications/ingest
